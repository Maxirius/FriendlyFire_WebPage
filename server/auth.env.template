# Environment template for the FriendlyFire auth service.
# Copy to a root-owned 0600 file (e.g. /opt/hostings/minecraft_auth/auth.env)
# and fill in real values. NEVER commit the populated file.

# Public origin of the site (drives cookie flags + emailed links)
FF_PUBLIC_ORIGIN=https://mc.max-kuehn.com

# Bootstrap admin (applies at startup; existing admins are preserved)
FF_ADMIN_EMAIL=admin@example.invalid
FF_ADMIN_PASSWORD=CHANGE_ME_long_random

# Mailcow SMTP submission (uses STARTTLS on the mail submission port)
FF_SMTP_HOST=host.max-kuehn.com
FF_SMTP_PORT=587
FF_SMTP_USER=notifications@max-kuehn.com
FF_SMTP_PASS=CHANGE_ME
FF_MAIL_FROM=notifications@max-kuehn.com
FF_SMTP_TLS=starttls

# Persistence + tuning
FF_AUTH_DB=/data/auth.db
FF_STATIC_DIR=/srv/web
FF_SESSION_TTL_H=168
FF_INVITE_TTL_H=48
FF_RESET_TTL_MIN=30
FF_LOG_LEVEL=INFO
